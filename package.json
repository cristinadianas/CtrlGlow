{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.1.0",
  "description": "Lighting control for my PC, built on OpenRGB",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node src/service/index.ts --open",
    "service": "node src/service/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "devices": "node tools/list-devices.mts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
